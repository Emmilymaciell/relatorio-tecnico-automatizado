# ==============================================================
# PROG_Relatorio_G2_Automacao — modelo do .env
# Copie para `.env` e preencha. O `.env` real NUNCA vai para o Git.
# Este projeto e SOMENTE LEITURA em relacao ao SharePoint.
# ==============================================================

# Service principal do Entra ID (app "Entra ID - PROGRAMA").
# AZURE_CLIENT_SECRET e o campo "Valor" do segredo do cliente, nao o "ID Secreto".
# Nunca cole esse valor em conversa, log, commit ou documento.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Alvo SharePoint (referencia; confirmado por API).
SHAREPOINT_HOSTNAME=contoso.sharepoint.com
SHAREPOINT_SITE_PATH=/sites/exemplo
